# Copy to .env (git-ignored). Used by scripts/demo.py and deploy.sh. Never commit real values.

# Trello: https://trello.com/power-ups/admin -> your app -> API key; generate a token from the same page.
TRELLO_API_KEY=
TRELLO_TOKEN=
# Same app page -> "Secret". Signs Trello webhooks.
TRELLO_APP_SECRET=
# Printed by `scripts.demo setup`.
TRELLO_SUPPORT_BOARD_ID=
TRELLO_ENGINEERING_BOARD_ID=
# Cloud Run URL + /trello/webhook, exactly as registered with Trello.
TRELLO_WEBHOOK_CALLBACK_URL=

# Dust: Webhook URL of the custom webhook source used by the triage agent's trigger.
DUST_WEBHOOK_URL=
# Signing secret of that webhook source (header X-Dust-Signature, algorithm sha256). Optional.
DUST_WEBHOOK_SECRET=

# Shared secret that Dust sends as "Authorization: Bearer ..." to the MCP server. Generate: openssl rand -hex 32
MCP_BEARER_TOKEN=

GCP_PROJECT=
GCP_REGION=europe-west1
